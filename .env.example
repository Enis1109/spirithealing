DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@spirit-healing.tr
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM=Spirit Healing <website@spirit-healing.tr>
CONTACT_NOTIFICATION_TO=info@spirit-healing.tr

# Bank details are sent by email only after a Zepter bank-transfer booking.
ZEPTER_BANK_ACCOUNT_NAME=
ZEPTER_BANK_IBAN=
ZEPTER_BANK_BIC=
ZEPTER_LANDING_ORIGINS=https://spirit-healing-zepter.sschmidt78.chatgpt.site

PUBLIC_BASE_URL=https://www.spirit-healing.tr
NEWSLETTER_TOKEN_SECRET=replace_with_a_long_random_value

# Aufgezeichneter 13-Wochen-Online-Vortrag mit flexibel wählbaren Startzeiten.
# Die Zeiten gelten in Europe/Berlin. Ab dem Startdatum sind auch Termine am selben Tag möglich.
WEBINAR_TIME_ZONE=Europe/Berlin
WEBINAR_START_TIMES=08:00,09:00,10:00,11:00,12:00,13:00,14:00,15:00,16:00,17:00,18:00,19:00,20:00,21:00,22:00
WEBINAR_DAYS_AHEAD=7
WEBINAR_FIRST_DATE=2026-09-03
WEBINAR_FIRST_DAY_START_TIME=08:00
WEBINAR_MIN_LEAD_MINUTES=15
WEBINAR_ACCESS_EARLY_MINUTES=5
WEBINAR_ACCESS_WINDOW_MINUTES=240
WEBINAR_TOKEN_SECRET=replace_with_a_separate_long_random_value
# Optional: überschreibt den bereits hinterlegten Vimeo-Vortrag.
# Normale Vimeo-Freigabelinks und Vimeo-Einbettungsadressen werden unterstützt.
# WEBINAR_VIDEO_EMBED_URL=https://vimeo.com/VIDEO_ID/PRIVATE_HASH
MEMBER_RECORDING_KEY=replace_with_the_32_byte_base64url_key
MEMBER_ICH_BIN_LICHT_KEY=replace_with_the_32_byte_base64url_key
# Recommended: stream the recording through a video platform instead of Hostinger.
# Supported embeds: YouTube (including youtube-nocookie.com), Vimeo, Bunny Stream, Cloudflare Stream.
# Optional: overrides the protected Vimeo recording configured by the application.
# MEMBER_RECORDING_EMBED_URL=https://player.vimeo.com/video/VIDEO_ID
# Optional Stripe payment link for the future Premium membership.
# MEMBER_PREMIUM_CHECKOUT_URL=https://buy.stripe.com/...
# Comma-separated owner emails that receive the administration shortcut.
MEMBER_ADMIN_EMAILS=info@spirit-healing.tr,selcan1975@gmx.de
# Optional alternative to the encrypted bundled recording:
# MEMBER_RECORDING_PATH=/home/username/domains/spirit-healing.tr/private_media/vortrag.mp4
COOKIE_SECURE=true
PORT=3000

# AI Command Center: keep mock until billing and the server secret are approved.
AI_COMMAND_CENTER_MODE=mock
OPENAI_API_KEY=
OPENAI_ROUTINE_MODEL=gpt-5.6-luna
OPENAI_REVIEW_MODEL=gpt-5.6-terra
AI_COMMAND_CENTER_WEB_SEARCH=true

# Optional specialist for long scripts and narrative text. Keep disabled until
# a separate Anthropic API account, budget and server key are approved.
ANTHROPIC_CONTENT_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_EDITORIAL_MODEL=claude-sonnet-5

# Optional image generation. Each paid image run still needs an application-level
# confirmation before this switch is enabled in the server environment.
OPENAI_IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_DRAFT_QUALITY=low
OPENAI_IMAGE_FINAL_QUALITY=medium
